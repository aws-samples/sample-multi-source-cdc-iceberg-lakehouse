{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Financial Transaction Data Schema",
  "description": "Schema for financial transaction data generated by the Iceberg Data Lakehouse project",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string",
      "description": "Unique transaction identifier with format TXN + 12 character UUID",
      "pattern": "^TXN[a-f0-9]{12}$"
    },
    "transaction_reference_id": {
      "type": "string",
      "description": "Transaction reference identifier with format REF + 12 character UUID",
      "pattern": "^REF[a-f0-9]{12}$"
    },
    "transaction_type": {
      "type": "string",
      "description": "Type of transaction",
      "enum": ["PURCHASE", "REFUND", "PAYMENT", "WITHDRAWAL", "DEPOSIT", "TRANSFER", "BILL_PAYMENT"]
    },
    "transaction_subtype": {
      "type": "string",
      "description": "Subtype of transaction",
      "enum": ["RETAIL", "ONLINE", "RECURRING", "INSTALLMENT", "CASH_ADVANCE", "ATM", "POS", "MOBILE"]
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp with Z suffix",
      "format": "date-time"
    },
    "transaction_date": {
      "type": "string",
      "description": "Transaction date in YYYY-MM-DD format",
      "format": "date"
    },
    "transaction_time": {
      "type": "string",
      "description": "Transaction time in HH:mm:ss format",
      "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    },
    "transaction_timezone": {
      "type": "string",
      "description": "Transaction timezone",
      "default": "America/New_York"
    },
    "transaction_amount": {
      "type": "number",
      "description": "Transaction amount (negative for refunds)",
      "multipleOf": 0.01
    },
    "transaction_original_amount": {
      "type": "number",
      "description": "Original transaction amount before any adjustments",
      "multipleOf": 0.01
    },
    "currency": {
      "type": "string",
      "description": "Transaction currency code",
      "enum": ["USD", "EUR", "GBP", "CAD"]
    },
    "original_currency": {
      "type": "string",
      "description": "Original currency code",
      "enum": ["USD", "EUR", "GBP", "CAD"]
    },
    "exchange_rate": {
      "type": "number",
      "description": "Exchange rate applied to transaction",
      "minimum": 0
    },
    "transaction_status": {
      "type": "string",
      "description": "Current status of the transaction",
      "enum": ["COMPLETED", "PENDING", "DECLINED", "CANCELLED", "FAILED", "AUTHORIZED", "SETTLED"]
    },
    "transaction_description": {
      "type": "string",
      "description": "Human-readable transaction description"
    },
    "transaction_category": {
      "type": "string",
      "description": "High-level transaction category",
      "enum": ["SHOPPING", "DINING", "TRAVEL", "ENTERTAINMENT", "GROCERIES", "UTILITIES", "HEALTHCARE"]
    },
    "transaction_subcategory": {
      "type": "string",
      "description": "Detailed transaction subcategory"
    },
    "customer_id": {
      "type": "string",
      "description": "Customer identifier with format CUST + 7 digits",
      "pattern": "^CUST[0-9]{7}$"
    },
    "customer_uuid": {
      "type": "string",
      "description": "Customer UUID",
      "format": "uuid"
    },
    "customer_age": {
      "type": "integer",
      "description": "Customer age",
      "minimum": 18,
      "maximum": 85
    },
    "customer_gender": {
      "type": "string",
      "description": "Customer gender",
      "enum": ["Male", "Female", "Other", "Prefer not to say"]
    },
    "customer_income": {
      "type": "integer",
      "description": "Customer annual income in USD",
      "minimum": 0
    },
    "customer_income_range": {
      "type": "string",
      "description": "Customer income range bracket",
      "enum": ["Under 25000", "25000-50000", "50000-75000", "75000-100000", "100000-150000", "150000+"]
    },
    "customer_marital_status": {
      "type": "string",
      "description": "Customer marital status",
      "enum": ["Single", "Married", "Divorced", "Widowed", "Separated"]
    },
    "customer_residence_country": {
      "type": "string",
      "description": "Customer residence country code",
      "enum": ["US", "CA", "GB", "DE", "FR", "JP", "AU"]
    },
    "customer_residence_state": {
      "type": "string",
      "description": "Customer residence state/province code"
    },
    "customer_residence_city": {
      "type": "string",
      "description": "Customer residence city"
    },
    "customer_residence_zip": {
      "type": "string",
      "description": "Customer residence postal code",
      "pattern": "^[0-9]{5}$"
    },
    "customer_kyc_status": {
      "type": "string",
      "description": "Customer KYC verification status",
      "enum": ["Verified", "Pending"]
    },
    "customer_employment_status": {
      "type": "string",
      "description": "Customer employment status",
      "enum": ["Employed", "Self-Employed", "Unemployed", "Retired", "Student"]
    },
    "customer_education_level": {
      "type": "string",
      "description": "Customer education level",
      "enum": ["High School", "Associate's", "Bachelor's", "Master's", "Doctorate"]
    },
    "customer_risk_category": {
      "type": "string",
      "description": "Customer risk assessment category",
      "enum": ["Low", "Medium", "High"]
    },
    "customer_vip_flag": {
      "type": "boolean",
      "description": "Whether customer is VIP status"
    },
    "customer_loyalty_tier": {
      "type": "string",
      "description": "Customer loyalty program tier",
      "enum": ["Bronze", "Silver", "Gold", "Platinum", "Diamond"]
    },
    "customer_marketing_opt_in": {
      "type": "boolean",
      "description": "Whether customer opted in for marketing communications"
    },
    "customer_segment": {
      "type": "string",
      "description": "Customer market segment",
      "enum": ["Mass Market", "Mass Affluent", "Affluent", "High Net Worth"]
    },
    "customer_account_tenure_years": {
      "type": "integer",
      "description": "Years customer has been with the institution",
      "minimum": 1,
      "maximum": 20
    },
    "customer_loyalty_points": {
      "type": "integer",
      "description": "Customer loyalty points balance",
      "minimum": 0,
      "maximum": 10000
    },
    "merchant_id": {
      "type": "string",
      "description": "Merchant identifier with format MCHT + 7 digits",
      "pattern": "^MCHT[0-9]{7}$"
    },
    "merchant_name": {
      "type": "string",
      "description": "Merchant business name"
    },
    "merchant_category_code": {
      "type": "string",
      "description": "4-digit merchant category code",
      "pattern": "^[0-9]{4}$"
    },
    "merchant_category": {
      "type": "string",
      "description": "High-level merchant category",
      "enum": ["SHOPPING", "DINING", "TRAVEL", "ENTERTAINMENT", "GROCERIES", "UTILITIES", "HEALTHCARE"]
    },
    "merchant_subcategory": {
      "type": "string",
      "description": "Detailed merchant subcategory"
    },
    "merchant_rating": {
      "type": "number",
      "description": "Merchant rating from 1.0 to 5.0",
      "minimum": 1.0,
      "maximum": 5.0
    },
    "merchant_country": {
      "type": "string",
      "description": "Merchant country code",
      "enum": ["US", "CA", "GB", "DE", "FR", "JP", "AU"]
    },
    "merchant_state": {
      "type": "string",
      "description": "Merchant state/province code"
    },
    "merchant_city": {
      "type": "string",
      "description": "Merchant city"
    },
    "merchant_zip": {
      "type": "string",
      "description": "Merchant postal code",
      "pattern": "^[0-9]{5}$"
    },
    "merchant_average_txn_value": {
      "type": "number",
      "description": "Merchant's average transaction value",
      "minimum": 0
    },
    "merchant_chargeback_rate": {
      "type": "number",
      "description": "Merchant's chargeback rate as decimal",
      "minimum": 0,
      "maximum": 1
    },
    "merchant_high_risk_flag": {
      "type": "boolean",
      "description": "Whether merchant is flagged as high risk"
    },
    "payment_method": {
      "type": "string",
      "description": "Payment method used",
      "enum": ["Credit Card", "Debit Card", "Bank Transfer", "Digital Wallet", "Mobile Payment"]
    },
    "payment_method_type": {
      "type": "string",
      "description": "Specific payment method type",
      "enum": ["VISA", "MASTERCARD", "AMEX", "DISCOVER", "PAYPAL", "APPLE_PAY", "GOOGLE_PAY"]
    },
    "payment_method_subtype": {
      "type": "string",
      "description": "Payment method subtype with signature/standard designation"
    },
    "payment_card_last_four": {
      "type": "string",
      "description": "Last four digits of payment card",
      "pattern": "^[0-9]{4}$"
    },
    "payment_card_expiry": {
      "type": "string",
      "description": "Payment card expiry in MM/YY format",
      "pattern": "^(0[1-9]|1[0-2])/[0-9]{2}$"
    },
    "payment_card_issuer": {
      "type": "string",
      "description": "Payment card issuing bank"
    },
    "payment_card_country": {
      "type": "string",
      "description": "Payment card issuing country",
      "enum": ["US", "CA", "GB", "DE", "FR", "JP", "AU"]
    },
    "payment_card_funding_type": {
      "type": "string",
      "description": "Payment card funding type",
      "enum": ["CREDIT", "DEBIT"]
    },
    "payment_card_level": {
      "type": "string",
      "description": "Payment card level",
      "enum": ["STANDARD", "PREMIUM"]
    },
    "payment_card_bin": {
      "type": "string",
      "description": "Payment card Bank Identification Number (6 digits)",
      "pattern": "^[0-9]{6}$"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address of the transaction",
      "format": "ipv4"
    },
    "ip_geolocation_country": {
      "type": "string",
      "description": "IP geolocation country",
      "enum": ["US", "CA", "GB", "DE", "FR", "JP", "AU"]
    },
    "ip_geolocation_state": {
      "type": "string",
      "description": "IP geolocation state/province"
    },
    "ip_geolocation_city": {
      "type": "string",
      "description": "IP geolocation city"
    },
    "ip_geolocation_zip": {
      "type": "string",
      "description": "IP geolocation postal code",
      "pattern": "^[0-9]{5}$"
    },
    "ip_geolocation_latitude": {
      "type": "number",
      "description": "IP geolocation latitude",
      "minimum": -90,
      "maximum": 90
    },
    "ip_geolocation_longitude": {
      "type": "number",
      "description": "IP geolocation longitude",
      "minimum": -180,
      "maximum": 180
    },
    "vpn_usage_flag": {
      "type": "boolean",
      "description": "Whether VPN was used for the transaction"
    },
    "proxy_usage_flag": {
      "type": "boolean",
      "description": "Whether proxy was used for the transaction"
    },
    "tor_usage_flag": {
      "type": "boolean",
      "description": "Whether Tor was used for the transaction"
    },
    "is_fraud": {
      "type": "boolean",
      "description": "Whether transaction is fraudulent"
    },
    "fraud_score": {
      "type": "number",
      "description": "Fraud risk score (0-100)",
      "minimum": 0,
      "maximum": 100
    },
    "fraud_type": {
      "type": "string",
      "description": "Type of fraud detected",
      "enum": ["NONE", "STOLEN_CARD"]
    },
    "velocity_score": {
      "type": "number",
      "description": "Transaction velocity risk score (0-100)",
      "minimum": 0,
      "maximum": 100
    },
    "behavioral_risk_score": {
      "type": "number",
      "description": "Behavioral risk score (0-100)",
      "minimum": 0,
      "maximum": 100
    },
    "transaction_pattern_score": {
      "type": "number",
      "description": "Transaction pattern risk score (0-100)",
      "minimum": 0,
      "maximum": 100
    },
    "geo_anomaly_flag": {
      "type": "boolean",
      "description": "Whether geographic anomaly was detected"
    },
    "multiple_login_flag": {
      "type": "boolean",
      "description": "Whether multiple logins were detected"
    },
    "high_risk_ip_flag": {
      "type": "boolean",
      "description": "Whether IP is flagged as high risk"
    },
    "account_takeover_risk_score": {
      "type": "number",
      "description": "Account takeover risk score (0-100)",
      "minimum": 0,
      "maximum": 100
    },
    "chargeback_history_flag": {
      "type": "boolean",
      "description": "Whether customer has chargeback history"
    },
    "previous_fraud_flag": {
      "type": "boolean",
      "description": "Whether customer has previous fraud history"
    },
    "is_international": {
      "type": "boolean",
      "description": "Whether transaction is international"
    },
    "cross_border_flag": {
      "type": "boolean",
      "description": "Whether transaction crosses borders"
    },
    "high_risk_country_flag": {
      "type": "boolean",
      "description": "Whether transaction involves high-risk country"
    },
    "transaction_count_7d": {
      "type": "integer",
      "description": "Number of transactions in last 7 days",
      "minimum": 0
    },
    "transaction_amount_7d": {
      "type": "number",
      "description": "Total transaction amount in last 7 days",
      "minimum": 0,
      "multipleOf": 0.01
    },
    "avg_transaction_amount_7d": {
      "type": "number",
      "description": "Average transaction amount in last 7 days",
      "minimum": 0,
      "multipleOf": 0.01
    },
    "max_transaction_amount_7d": {
      "type": "number",
      "description": "Maximum transaction amount in last 7 days",
      "minimum": 0,
      "multipleOf": 0.01
    },
    "transaction_count_30d": {
      "type": "integer",
      "description": "Number of transactions in last 30 days",
      "minimum": 0
    },
    "transaction_amount_30d": {
      "type": "number",
      "description": "Total transaction amount in last 30 days",
      "minimum": 0,
      "multipleOf": 0.01
    },
    "avg_transaction_amount_30d": {
      "type": "number",
      "description": "Average transaction amount in last 30 days",
      "minimum": 0,
      "multipleOf": 0.01
    },
    "max_transaction_amount_30d": {
      "type": "number",
      "description": "Maximum transaction amount in last 30 days",
      "minimum": 0,
      "multipleOf": 0.01
    },
    "transaction_count_90d": {
      "type": "integer",
      "description": "Number of transactions in last 90 days",
      "minimum": 0
    },
    "transaction_amount_90d": {
      "type": "number",
      "description": "Total transaction amount in last 90 days",
      "minimum": 0,
      "multipleOf": 0.01
    },
    "transaction_count_365d": {
      "type": "integer",
      "description": "Number of transactions in last 365 days",
      "minimum": 0
    },
    "transaction_amount_365d": {
      "type": "number",
      "description": "Total transaction amount in last 365 days",
      "minimum": 0,
      "multipleOf": 0.01
    },
    "online_transaction_ratio_30d": {
      "type": "number",
      "description": "Ratio of online transactions in last 30 days",
      "minimum": 0,
      "maximum": 1
    },
    "average_daily_transactions_30d": {
      "type": "number",
      "description": "Average daily transactions in last 30 days",
      "minimum": 0,
      "multipleOf": 0.01
    },
    "days_active_last_30d": {
      "type": "integer",
      "description": "Number of active days in last 30 days",
      "minimum": 0,
      "maximum": 30
    }
  },
  "required": [
    "transaction_id",
    "transaction_reference_id",
    "transaction_type",
    "transaction_subtype",
    "timestamp",
    "transaction_date",
    "transaction_time",
    "transaction_timezone",
    "transaction_amount",
    "transaction_original_amount",
    "currency",
    "original_currency",
    "exchange_rate",
    "transaction_status",
    "transaction_description",
    "transaction_category",
    "transaction_subcategory",
    "customer_id",
    "customer_uuid",
    "customer_age",
    "customer_gender",
    "customer_income",
    "customer_income_range",
    "customer_marital_status",
    "customer_residence_country",
    "customer_residence_state",
    "customer_residence_city",
    "customer_residence_zip",
    "customer_kyc_status",
    "customer_employment_status",
    "customer_education_level",
    "customer_risk_category",
    "customer_vip_flag",
    "customer_loyalty_tier",
    "customer_marketing_opt_in",
    "customer_segment",
    "customer_account_tenure_years",
    "customer_loyalty_points",
    "merchant_id",
    "merchant_name",
    "merchant_category_code",
    "merchant_category",
    "merchant_subcategory",
    "merchant_rating",
    "merchant_country",
    "merchant_state",
    "merchant_city",
    "merchant_zip",
    "merchant_average_txn_value",
    "merchant_chargeback_rate",
    "merchant_high_risk_flag",
    "payment_method",
    "payment_method_type",
    "payment_method_subtype",
    "payment_card_last_four",
    "payment_card_expiry",
    "payment_card_issuer",
    "payment_card_country",
    "payment_card_funding_type",
    "payment_card_level",
    "payment_card_bin",
    "ip_address",
    "ip_geolocation_country",
    "ip_geolocation_state",
    "ip_geolocation_city",
    "ip_geolocation_zip",
    "ip_geolocation_latitude",
    "ip_geolocation_longitude",
    "vpn_usage_flag",
    "proxy_usage_flag",
    "tor_usage_flag",
    "is_fraud",
    "fraud_score",
    "fraud_type",
    "velocity_score",
    "behavioral_risk_score",
    "transaction_pattern_score",
    "geo_anomaly_flag",
    "multiple_login_flag",
    "high_risk_ip_flag",
    "account_takeover_risk_score",
    "chargeback_history_flag",
    "previous_fraud_flag",
    "is_international",
    "cross_border_flag",
    "high_risk_country_flag",
    "transaction_count_7d",
    "transaction_amount_7d",
    "avg_transaction_amount_7d",
    "max_transaction_amount_7d",
    "transaction_count_30d",
    "transaction_amount_30d",
    "avg_transaction_amount_30d",
    "max_transaction_amount_30d",
    "transaction_count_90d",
    "transaction_amount_90d",
    "transaction_count_365d",
    "transaction_amount_365d",
    "online_transaction_ratio_30d",
    "average_daily_transactions_30d",
    "days_active_last_30d"
  ],
  "additionalProperties": false
}
