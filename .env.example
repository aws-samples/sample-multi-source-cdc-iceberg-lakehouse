# Iceberg Lakehouse — deployment configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The Makefile will load .env automatically. All three values are required.
# Defaults for derived variables (region, backend bucket name) are set in the
# Makefile and can be overridden by exporting them in your shell before running
# make (e.g., export AWS_PRIMARY_REGION=us-west-2).

# Application name (lowercase, no whitespace) — used as a resource name prefix.
# Keep this short to avoid AWS resource name length limits.
APP_NAME=lakehouse

# Environment name (lowercase, no whitespace) — e.g. dev, prod, your-initials.
# Combined with APP_NAME for resource naming: ${APP_NAME}-${ENV_NAME}-...
ENV_NAME=dev

# 12-digit AWS account ID where resources will be deployed.
AWS_ACCOUNT_ID=123456789012

# IAM role granted full Lake Formation administration on your data lake.
# Must already exist in your AWS account. Typically this is the role you
# use to deploy this project. If you're using a user instead of a role,
# update the `setup-lake-formation-admin-role` target in the Makefile to
# use `arn:aws:iam::ACCOUNT:user/...` instead of `arn:aws:iam::ACCOUNT:role/...`.
LAKE_FORMATION_ADMIN_ROLE=YourAdminRoleName
